# Copie este arquivo para .env.local. Valores reais NUNCA entram no Git.
#
# MODO A — desenvolvimento isolado (padrão): deixe as variáveis opcionais vazias.
# O app usa o catálogo de exemplo e não mostra recursos de conta.
#
# MODO B — testar localmente contra STAGING: preencha com os valores do ambiente
# "Preview → staging" da Vercel (Supabase, Turnstile e Studio de staging), mas
# mantenha NEXT_PUBLIC_SITE_URL=http://localhost:3000. Nunca use valores de produção.
#
# Guia de ambientes e Vercel: docs/PASSO_A_PASSO_CONFIGURACAO_MANUAL.md (§5.3).

# ───────── Conteúdo (Studio) — SOMENTE servidor (sem NEXT_PUBLIC_) ─────────
# Vazio = catálogo de exemplo local. Para o modo B, use:
# https://content-api-staging.receitadahora.eu
STUDIO_PUBLIC_API_URL=
# Apenas no modo B: segredo HMAC de staging, idêntico ao APP_REVALIDATE_SECRET
# gravado no Worker do Studio. Não use em arquivos commitados.
STUDIO_REVALIDATE_SECRET=
# Idade máxima (horas) do snapshot de contingência quando o Studio está fora (padrão 72)
SNAPSHOT_MAX_AGE_HOURS=72
# Kill switch: ids/slugs separados por vírgula que nunca devem aparecer no fallback
CATALOG_BLOCKLIST=

# ───────── Supabase (contas) ─────────
# Vazio = app local, sem UI de conta. No modo B, use URL e chaves do projeto
# Supabase de staging. A publishable key é pública; a service role é segredo.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Em .env.local é SEMPRE localhost, inclusive ao usar Supabase staging.
# Na Vercel Preview → staging, este valor é https://app-staging.receitadahora.eu.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Só servidor, usada exclusivamente para excluir conta (/api/account). Nunca NEXT_PUBLIC_.
# Necessária somente para testar exclusão de conta no modo B.
SUPABASE_SERVICE_ROLE_KEY=

# ───────── CAPTCHA (Cloudflare Turnstile) — chave PÚBLICA do widget ─────────
# No modo B, use a site key do widget de staging que inclua "localhost" nos domínios.
# Só preencha depois de ativar o CAPTCHA também no projeto Supabase de staging.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
