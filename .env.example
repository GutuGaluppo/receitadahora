# Copie para .env.local (desenvolvimento) e cadastre os mesmos nomes no Vercel (Preview/Production).
# Valores reais NUNCA entram no Git. Guia completo: docs/PASSO_A_PASSO_CONFIGURACAO_MANUAL.md

# ───────── Conteúdo (Studio) — SOMENTE servidor (sem NEXT_PUBLIC_) ─────────
# Vazio = modo local: usa src/data/catalog.snapshot.json (catálogo de exemplo)
STUDIO_PUBLIC_API_URL=
# Segredo HMAC do webhook; precisa ser IDÊNTICO ao APP_REVALIDATE_SECRET do Worker do Studio
STUDIO_REVALIDATE_SECRET=
# Idade máxima (horas) do snapshot de contingência quando o Studio está fora (padrão 72)
SNAPSHOT_MAX_AGE_HOURS=72
# Kill switch: ids/slugs separados por vírgula que nunca devem aparecer no fallback
CATALOG_BLOCKLIST=

# ───────── Supabase (contas) — vazio = app 100% local, sem UI de conta ─────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Só servidor, só para excluir conta (/api/account). Nunca NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ───────── CAPTCHA (Cloudflare Turnstile) — chave PÚBLICA do widget ─────────
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
